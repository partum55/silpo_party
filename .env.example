NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Base64-encoded 32-byte key; must stay stable once users connect Silpo (see README).
SILPO_CREDENTIALS_KEY=base64-encoded-32-byte-key

# DeepSeek API key. The agent always uses the deepseek-flash model.
AI_API_KEY=your-deepseek-api-key

# Optional debugging for the agent: disable its cache, or log raw Silpo MCP responses and cache hits.
# SILPO_CACHE_DISABLED=1
# SILPO_DEBUG_LOG=1
