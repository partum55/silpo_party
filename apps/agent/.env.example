NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
SILPO_CREDENTIALS_KEY=base64-encoded-32-byte-key
AI_API_KEY=your-deepseek-api-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro

# Shared secret checked by server.auth in src/mastra/index.ts — must equal the root app's
# AGENT_INTERNAL_TOKEN, since the deployed agent's HTTP API otherwise has no caller check.
AGENT_INTERNAL_TOKEN=shared-secret-with-the-web-backend-deployment

# Root app's own URL (its AGENT_URL points here in reverse) — used by src/mastra/party-status.ts to report
# turn progress back to /api/parties/[partyId]/agent-status. Progress reporting is skipped, not fatal, when unset.
APP_URL=https://your-web-backend-deployment.example.com

# Optional per-role models. "fast" parses messages and picks products; "smart" writes recipes and event
# checklists. Both default to AI_MODEL.
# AI_MODEL_FAST=deepseek-v4-pro
# AI_MODEL_SMART=deepseek-v4-pro

# Caching (see src/cache): search results, product details, learned query -> product choices, recipes.
# Uses the agent_cache table when Supabase is configured. Set to 1 to disable while debugging.
# SILPO_CACHE_DISABLED=1
# Logs raw Silpo MCP responses and cache hits/misses.
# SILPO_DEBUG_LOG=1
