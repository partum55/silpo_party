NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
SILPO_CREDENTIALS_KEY=base64-encoded-32-byte-key
AI_API_KEY=your-deepseek-api-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Shared secret checked by server.auth in src/mastra/index.ts — must equal the root app's
# AGENT_INTERNAL_TOKEN, since the deployed agent's HTTP API otherwise has no caller check.
AGENT_INTERNAL_TOKEN=shared-secret-with-the-web-backend-deployment

# Root app's own URL (its AGENT_URL points here in reverse) — used by src/mastra/party-status.ts to report
# turn progress back to /api/parties/[partyId]/agent-status. Progress reporting is skipped, not fatal, when unset.
APP_URL=https://your-web-backend-deployment.example.com
