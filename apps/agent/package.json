{
  "name": "@silpo-party/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/mastra/index.ts",
    "./gateway": "./src/gateway-entry.ts",
    "./conversational-workflow": "./src/mastra/conversational-workflow.ts"
  },
  "scripts": {
    "dev": "mastra dev --env ../../.env.local",
    "build": "npm_config_allow_scripts= mastra build && node scripts/fix-mastra-imports.mjs",
    "start": "node .mastra/output/index.mjs",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.48",
    "@mastra/core": "1.66.0",
    "@mastra/deployer-vercel": "1.2.25",
    "@silpo-party/silpo-mcp": "*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "mastra": "1.29.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
